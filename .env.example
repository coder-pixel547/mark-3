# ==========================================
# Swarify Configuration & LLM API Keys
# ==========================================

# Optional: Add any of these keys for enhanced AI Playlist Generation.
# If no key is provided, Swarify automatically uses its built-in
# Multi-Language Heuristic Music Engine with zero setup.

# OpenAI API Key (e.g. gpt-4o-mini / gpt-3.5-turbo)
OPENAI_API_KEY=

# Groq API Key (Ultra-fast Llama 3 - Free tier: https://console.groq.com)
GROQ_API_KEY=

# Google Gemini API Key (Gemini 1.5 Flash - Free tier: https://aistudio.google.com)
GEMINI_API_KEY=

# Server Port
PORT=8000
