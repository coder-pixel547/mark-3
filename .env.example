# ==========================================
# Swarify Configuration & Security Keys
# ==========================================

# Optional: Add any of these keys for enhanced AI Playlist Generation.
# If no key is provided, Swarify automatically uses its built-in
# Multi-Language Heuristic Music Engine with zero setup.

# OpenAI API Key (e.g. gpt-4o-mini / gpt-3.5-turbo)
OPENAI_API_KEY=

# Groq API Key (Ultra-fast Llama 3 - Free tier: https://console.groq.com)
GROQ_API_KEY=

# Google Gemini API Key (Gemini 1.5 Flash - Free tier: https://aistudio.google.com)
GEMINI_API_KEY=

# Security & Admin Access
# Set a strong secret key (32+ chars) to protect admin endpoints and diagnostic routes
ADMIN_SECRET_KEY=

# Optional: Pre-hashed admin password using PBKDF2 (e.g. pbkdf2:sha256:600000$salt$hash)
ADMIN_PASSWORD_HASH=

# Allowed CORS Origins (comma-separated; leave empty for secure production defaults)
# e.g. https://swarify-music-b0e9.onrender.com,http://localhost:8000
ALLOWED_ORIGINS=

# Environment mode ('production' or 'development')
ENV=production

# Server Port
PORT=8000
